@page "/decks/{DeckId:guid}"
@implements IDisposable
@using RecallDeck.Core
@inject DeckService DeckService
@inject CardService CardService
@inject NavigationManager Navigation

<PageTitle>@(deck?.Title ?? "Deck") · RecallDeck</PageTitle>
<a href="/decks">Back to decks</a>
@if (loading)
{
    <h1 tabindex="-1">Deck</h1>
}
else if (missing)
{
    <h1 tabindex="-1">Deck unavailable</h1>
    <p>This deck is no longer available. Return to your decks to open another one.</p>
}
else if (loadFailed)
{
    <h1 tabindex="-1">Deck</h1>
    <div role="alert">
        <p>We could not load this deck. Try again to read your saved cards. @StorageRecovery</p>
        <button id="retry-load" type="button" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (deck is not null)
{
    <h1 tabindex="-1">@deck.Title</h1>
    @if (deck.Description.Length > 0)
    {
        <p class="deck-description">@deck.Description</p>
    }
    <p><a id="review-deck" href="@($"/review?deck={deck.Id}")">Review due cards in this deck</a></p>
    <button id="delete-deck" type="button" class="secondary" disabled="@(saving || confirming || editingId is not null)" @onclick="BeginDeckDeleteAsync">Delete deck</button>
    @if (confirming)
    {
        <section id="delete-confirmation" class="delete-confirmation" aria-labelledby="delete-heading">
            <h2 id="delete-heading" tabindex="-1" @ref="confirmationHeading">@(deletingDeck ? "Delete this deck?" : "Delete this card?")</h2>
            @if (deletingDeck)
            {
                <p>Delete “@deck.Title” and its @cards.Count @(cards.Count == 1 ? "card" : "cards")? All its cards and their review history will be permanently removed. This cannot be undone.</p>
            }
            else
            {
                <p>Delete the card with this front? Its review history will also be permanently removed. This cannot be undone.</p>
                <p class="card-text">@deletingCard?.Front</p>
            }
            @if (deleteError is not null)
            {
                <p role="alert">@deleteError</p>
            }
            <div class="form-actions">
                <button id="confirm-delete" type="button" disabled="@saving" @onclick="ConfirmDeleteAsync">@(saving ? "Deleting…" : deletingDeck ? "Confirm delete deck" : "Confirm delete card")</button>
                <button id="cancel-delete" type="button" class="secondary" disabled="@saving" @onclick="CancelDelete">Cancel</button>
            </div>
        </section>
    }
    @if (actionError is not null)
    {
        <p role="alert">@actionError</p>
    }
    <div class="deck-workspace">
        <section aria-labelledby="editor-heading">
            <h2 id="editor-heading">@(editingId is null ? "Create a card" : "Edit card")</h2>
            <form id="card-editor" @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
                <fieldset disabled="@(saving || confirming)">
                    <legend class="visually-hidden">Card text</legend>
                    <label for="card-front">Front</label>
                    <p id="card-front-hint" class="field-hint">Required · 1–4000 characters · plain text</p>
                    <textarea id="card-front" @ref="frontInput" @bind="front" @bind:event="oninput" required maxlength="4000" rows="5"
                              aria-invalid="@(frontError is not null ? "true" : null)"
                              aria-describedby="@(frontError is null ? "card-front-hint" : "card-front-hint card-front-error")"></textarea>
                    @if (frontError is not null)
                    {
                        <p id="card-front-error" class="field-error" role="alert">@frontError</p>
                    }
                    <label for="card-back">Back</label>
                    <p id="card-back-hint" class="field-hint">Required · 1–4000 characters · plain text</p>
                    <textarea id="card-back" @bind="back" @bind:event="oninput" required maxlength="4000" rows="5"
                              aria-invalid="@(backError is not null ? "true" : null)"
                              aria-describedby="@(backError is null ? "card-back-hint" : "card-back-hint card-back-error")"></textarea>
                    @if (backError is not null)
                    {
                        <p id="card-back-error" class="field-error" role="alert">@backError</p>
                    }
                    @if (saveError is not null)
                    {
                        <p class="field-error" role="alert">@saveError</p>
                    }
                    <div class="form-actions">
                        <button type="submit">@(saving && !confirming ? "Saving…" : editingId is null ? "Create card" : "Save card")</button>
                        @if (editingId is not null)
                        {
                            <button id="cancel-edit" type="button" class="secondary" @onclick="CancelEdit">Cancel edit</button>
                        }
                    </div>
                </fieldset>
            </form>
        </section>
        <section aria-labelledby="cards-heading">
            <h2 id="cards-heading" tabindex="-1" @ref="cardsHeading">Cards (@cards.Count)</h2>
            @if (cards.Count == 0)
            {
                <p>No cards yet. Add a question on the front and an answer on the back.</p>
            }
            else
            {
                <ul class="deck-list">
                    @foreach (var card in cards)
                    {
                        <li class="deck-row card-row" @key="card.Id">
                            <h3>Front</h3>
                            <p class="card-text card-front">@card.Front</p>
                            <h3>Back</h3>
                            <p class="card-text card-back">@card.Back</p>
                            <div class="form-actions">
                                <button type="button" class="secondary edit-card" disabled="@(saving || confirming || editingId is not null)" @onclick="() => BeginEdit(card)">Edit card</button>
                                <button type="button" class="secondary delete-card" disabled="@(saving || confirming || editingId is not null)" @onclick="() => BeginCardDelete(card)">Delete card</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
    <p class="note">Cards are saved on this device. Review due cards from this deck or the Review page. Export a backup from the Backup page and keep it outside this app. In a browser, offline use needs a first online load and completed app installation. Browser data can be cleared or evicted.</p>
}
<p role="status" aria-live="polite">@(loading ? "Loading deck…" : status)</p>

@code {
    [Parameter] public Guid DeckId { get; set; }

    private const string StorageRecovery = "If storage is full, free space outside this app, then retry. In a browser, allow site storage. If the database needs a newer app, copy unsaved text and open a compatible updated app. Do not clear this app's data.";
    private const string TextError = "Enter text from 1 to 4000 characters.";
    private Deck? deck;
    private List<Card> cards = [];
    private Guid? loadedId;
    private int version;
    private bool loading = true;
    private bool loadFailed;
    private bool missing;
    private bool saving;
    private bool confirming;
    private bool deletingDeck;
    private Card? deletingCard;
    private Guid? editingId;
    private string front = "";
    private string back = "";
    private string? frontError;
    private string? backError;
    private string? saveError;
    private string? deleteError;
    private string? actionError;
    private string status = "";
    private string? focusTarget;
    private ElementReference frontInput;
    private ElementReference cardsHeading;
    private ElementReference confirmationHeading;

    public void Dispose()
    {
        version++;
        focusTarget = null;
    }

    protected override Task OnParametersSetAsync()
    {
        if (loadedId == DeckId) return Task.CompletedTask;

        loadedId = DeckId;
        deck = null;
        cards = [];
        saving = confirming = deletingDeck = false;
        deletingCard = null;
        ClearEditor();
        deleteError = actionError = focusTarget = null;
        status = "";
        return LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusTarget is null || loading || deck is null) return;

        var target = focusTarget;
        focusTarget = null;
        await (target == "editor" ? frontInput : target == "confirmation" ? confirmationHeading : cardsHeading).FocusAsync();
    }

    private async Task LoadAsync()
    {
        var current = ++version;
        loading = true;
        loadFailed = missing = false;
        try
        {
            var detail = await DeckService.GetAsync(DeckId);
            if (current != version) return;

            deck = detail.Deck;
            cards = detail.Cards.ToList();
        }
        catch (KeyNotFoundException)
        {
            if (current == version) missing = true;
        }
        catch (Exception)
        {
            if (current == version) loadFailed = true;
        }
        finally
        {
            if (current == version) loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (saving || confirming || deck is null || loading || missing || loadFailed) return;

        saving = true;
        var current = version;
        var id = editingId;
        frontError = backError = saveError = actionError = null;
        status = "";
        try
        {
            var saved = id is null
                ? await CardService.CreateAsync(deck.Id, front, back)
                : await CardService.EditAsync(id.Value, front, back);
            if (current != version) return;

            if (id is null) cards.Add(saved);
            else cards[cards.FindIndex(card => card.Id == id)] = saved;
            ClearEditor();
            focusTarget = id is null ? "editor" : "cards";
            status = id is null ? "Card created." : "Card saved.";
        }
        catch (ArgumentException error) when (error.ParamName is "front" or "back")
        {
            if (current != version) return;
            if (error.ParamName == "front") frontError = TextError;
            else backError = TextError;
        }
        catch (KeyNotFoundException)
        {
            if (current == version) saveError = "This card or deck is no longer available. Your text is still here. Copy it before returning to your decks.";
        }
        catch (Exception)
        {
            if (current == version) saveError = "We could not save your card. Your text is still here. Try again with the save button. " + StorageRecovery;
        }
        finally
        {
            if (current == version) saving = false;
        }
    }

    private void BeginEdit(Card card)
    {
        if (saving || confirming || editingId is not null) return;

        editingId = card.Id;
        front = card.Front;
        back = card.Back;
        frontError = backError = saveError = actionError = null;
        status = "";
        focusTarget = "editor";
    }

    private void ClearEditor()
    {
        editingId = null;
        front = back = "";
        frontError = backError = saveError = null;
    }

    private void CancelEdit()
    {
        if (saving || confirming) return;

        ClearEditor();
        focusTarget = "cards";
    }

    private void BeginCardDelete(Card card)
    {
        if (saving || confirming || editingId is not null) return;

        deletingCard = card;
        deletingDeck = false;
        confirming = true;
        deleteError = actionError = null;
        status = "";
        focusTarget = "confirmation";
    }

    private async Task BeginDeckDeleteAsync()
    {
        if (saving || confirming || editingId is not null || deck is null) return;

        saving = true;
        var current = version;
        actionError = null;
        status = "";
        try
        {
            var detail = await DeckService.GetAsync(deck.Id);
            if (current != version) return;

            deck = detail.Deck;
            cards = detail.Cards.ToList();
            deletingDeck = confirming = true;
            deletingCard = null;
            deleteError = null;
            focusTarget = "confirmation";
        }
        catch (KeyNotFoundException)
        {
            if (current == version) actionError = "This deck is no longer available. Return to your decks to open another one.";
        }
        catch (Exception)
        {
            if (current == version) actionError = "We could not read the current card count. Try again with Delete deck. " + StorageRecovery;
        }
        finally
        {
            if (current == version) saving = false;
        }
    }

    private void CancelDelete()
    {
        if (saving) return;

        confirming = deletingDeck = false;
        deletingCard = null;
        deleteError = null;
        focusTarget = "cards";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (saving || !confirming || deck is null) return;

        saving = true;
        var current = version;
        deleteError = null;
        status = "";
        try
        {
            if (deletingDeck)
            {
                await DeckService.DeleteAsync(deck.Id);
                if (current == version) Navigation.NavigateTo("/decks");
            }
            else if (deletingCard is not null)
            {
                var id = deletingCard.Id;
                await CardService.DeleteAsync(id);
                if (current != version) return;

                cards.RemoveAll(card => card.Id == id);
                confirming = deletingDeck = false;
                deletingCard = null;
                focusTarget = "cards";
                status = "Card deleted.";
            }
        }
        catch (KeyNotFoundException)
        {
            if (current == version) deleteError = "This card or deck is no longer available. Cancel and return to your decks to read the current data.";
        }
        catch (Exception)
        {
            if (current == version) deleteError = "We could not delete this item. Your saved data is unchanged. Try again with the confirm button. " + StorageRecovery;
        }
        finally
        {
            if (current == version) saving = false;
        }
    }
}
