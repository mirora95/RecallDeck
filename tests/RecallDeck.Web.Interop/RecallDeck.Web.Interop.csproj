<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <ProjectReference Include="../../src/RecallDeck.Core/RecallDeck.Core.csproj" />
    <Compile Include="../../src/RecallDeck.Web/Storage/IndexedDbStudyStore.cs" Link="IndexedDbStudyStore.cs" />
  </ItemGroup>
  <Target Name="CopyStorageModule" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="../../src/RecallDeck.Web/wwwroot/study-store.js" DestinationFolder="$(ProjectDir)wwwroot" />
  </Target>
</Project>
