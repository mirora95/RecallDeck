<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecallDeck.Android.UiSmoke</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationTitle>RecallDeck UI checks</ApplicationTitle>
    <ApplicationId>io.github.mirora95.recalldeck.uismoke</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="../../src/RecallDeck.Mobile/Resources/AppIcon/appicon.svg" ForegroundFile="../../src/RecallDeck.Mobile/Resources/AppIcon/appiconfg.svg" Color="#243e35" />
    <MauiSplashScreen Include="../../src/RecallDeck.Mobile/Resources/Splash/splash.svg" Color="#243e35" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <ProjectReference Include="../../src/RecallDeck.UI/RecallDeck.UI.csproj" />
    <ProjectReference Include="../../src/RecallDeck.Storage.Sqlite/RecallDeck.Storage.Sqlite.csproj" />
    <Compile Include="../../src/RecallDeck.Mobile/Backup/*.cs" Link="Backup/%(Filename)%(Extension)" />
    <Compile Include="../RecallDeck.Storage.Checks/UiFailureStudyStore.cs" Link="UiFailureStudyStore.cs" />
  </ItemGroup>
</Project>
